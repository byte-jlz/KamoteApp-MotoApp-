{
  "expo": {
    "name": "MotoPMS",
    "slug": "motopms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motopms.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.motopms.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "MotoPMS lets you pick photos and videos of your rides, parts and receipts.",
          "cameraPermission": "MotoPMS lets you take photos and videos of your rides, parts and receipts.",
          "microphonePermission": "MotoPMS records sound when you take videos of your rides."
        }
      ],
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "scheme": "motopms",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/3c9e378f-75b0-4717-9241-2a7a390a048b"
    },
    "extra": {
      "updateManifestUrl": "",
      "router": {},
      "eas": {
        "projectId": "3c9e378f-75b0-4717-9241-2a7a390a048b"
      }
    },
    "owner": "julzplaza9"
  }
}
